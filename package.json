{
  "name": "acta-cosmica",
  "description": "A photo-forward news and magazine theme for Ghost",
  "version": "2.0.2",
  "engines": {
    "ghost": ">=6.37.0"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Bradley Thomas",
    "email": "brad.thomas@gmail.com",
    "url": "https://bradleyt.com"
  },
  "keywords": [
    "ghost-theme",
    "news",
    "magazine",
    "blog",
    "editorial"
  ],
  "gpm": {
    "type": "theme",
    "categories": [
      "Editorial",
      "Magazine"
    ]
  },
  "config": {
    "posts_per_page": 9,
    "image_sizes": {
      "xs": { "width": 320 },
      "s": { "width": 640 },
      "m": { "width": 960 },
      "l": { "width": 1280 },
      "xl": { "width": 1920 }
    },
    "card_assets": {
      "include": ["audio", "video", "nft", "product", "file", "header_v2"]
    },
    "custom": {
      "color_scheme": {
        "type": "select",
        "options": ["System", "Light", "Dark"],
        "default": "System",
        "description": "System follows each reader's device. Light or Dark locks the site."
      },
      "accent_color": {
        "type": "color",
        "default": "#f5c518"
      },
      "show_logo_mark": {
        "type": "boolean",
        "default": true,
        "description": "Show the accent-color square beside the site name in the header and footer"
      },
      "accent_text_light": {
        "type": "boolean",
        "default": false,
        "description": "Turn on if a dark accent color makes button text hard to read"
      },
      "drop_cap_on_pages": {
        "type": "boolean",
        "default": false,
        "description": "Turn on to also drop-cap the opening paragraph of pages (About, Privacy, etc.), not just posts"
      },
      "hero_video_url": {
        "type": "text",
        "default": "",
        "group": "homepage",
        "description": "Direct .mp4/.webm URL — autoplays as the top story's background instead of its feature image"
      },
      "persistent_player": {
        "type": "boolean",
        "default": true,
        "group": "post",
        "description": "Keep a playing #video post's video going in a mini-player as readers browse"
      },
      "mini_player_position": {
        "type": "select",
        "options": ["Bottom right", "Bottom left"],
        "default": "Bottom right",
        "group": "post",
        "visibility": "persistent_player:true"
      },
      "enable_ads": {
        "type": "boolean",
        "default": false,
        "description": "Show ad slots, filled from pages slugged ad-header, ad-feed, etc. Paid members never see ads."
      },
      "adsense_publisher_id": {
        "type": "text",
        "default": "",
        "visibility": "enable_ads:true",
        "description": "ca-pub-XXXXXXXXXXXXXXXX — loads AdSense (and Auto ads)"
      },
      "ad_consent_mode": {
        "type": "boolean",
        "default": true,
        "visibility": "enable_ads:true",
        "description": "Deny ad cookies in the EEA, UK and Switzerland until a consent tool allows them"
      },
      "footer_description": {
        "type": "text",
        "default": "An independent, reader-funded newsroom covering science, nature, and the people exploring both — with rigor and beauty in equal measure."
      },
      "show_footer_credit": {
        "type": "boolean",
        "default": true
      },
      "footer_credit_label": {
        "type": "text",
        "default": "designed and built by"
      },
      "footer_credit_name": {
        "type": "text",
        "default": ""
      },
      "footer_credit_url": {
        "type": "text",
        "default": ""
      }
    }
  },
  "devDependencies": {
    "tailwindcss": "^4.3.2",
    "@tailwindcss/cli": "^4.3.2",
    "gscan": "^6.4.1",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.0"
  },
  "scripts": {
    "build": "tailwindcss -i ./assets/css/screen.css -o ./assets/built/screen.css --minify",
    "dev": "tailwindcss -i ./assets/css/screen.css -o ./assets/built/screen.css --watch",
    "test": "gscan .",
    "migrate": "node scripts/migrate-from-astro.mjs",
    "create-legal-pages": "node scripts/create-legal-pages.mjs",
    "package": "npm run build && node scripts/package-theme.mjs"
  }
}
