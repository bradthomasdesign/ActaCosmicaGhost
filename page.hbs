{{!< default}}
{{#page}}

{{> "site-header"}}

<main id="main-content">

{{#if @page.show_title_and_feature_image}}
<section style="max-width:1280px;margin:0 auto;padding:48px 24px 30px;">
  <div style="font:600 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.1em;text-transform:uppercase;color:#6b6459;margin-bottom:18px;">
    <a href="{{@site.url}}" style="color:#6b6459;text-decoration:none;">Home</a>
    <span style="margin:0 8px;">›</span>
    <span style="color:#16130d;">{{title}}</span>
  </div>
  <div style="display:flex;align-items:flex-start;gap:16px;max-width:820px;">
    <span style="width:14px;align-self:stretch;background:var(--accent,{{@custom.accent_color}});display:block;flex:0 0 auto;"></span>
    <div>
      <h1 style="font:800 clamp(44px,6.5vw,80px)/0.98 var(--gh-font-heading,'Archivo'),sans-serif;letter-spacing:-0.02em;color:#16130d;margin:0 0 16px;">{{title}}</h1>
      {{#if custom_excerpt}}<p style="font:400 clamp(18px,1.7vw,22px)/1.5 var(--gh-font-body,'Newsreader'),Georgia,serif;color:#4a4437;margin:0;">{{custom_excerpt}}</p>{{/if}}
    </div>
  </div>
</section>
{{#if feature_image}}
<section style="max-width:1120px;margin:0 auto;padding:0 24px 20px;">
  <img src="{{img_url feature_image size="l"}}" alt="{{title}}" style="width:100%;border-radius:4px;display:block;" />
</section>
{{/if}}
{{/if}}

<article class="{{post_class}} page-prose article-body" style="max-width:760px;margin:0 auto;padding:32px 24px 80px;font:400 20px/1.72 var(--gh-font-body,'Newsreader'),Georgia,serif;color:#26221a;">
  {{content}}
</article>

{{!-- A homepage section page opened at its own URL shows the same row it
      contributes to the homepage, rather than an empty page. --}}
{{#has tag="#home-spotlight"}}{{#if primary_tag}}{{> "home-spotlight-row" section_tag=primary_tag.slug}}{{/if}}{{/has}}

{{> "newsletter"}}
</main>

{{> "site-footer"}}
{{> "nav-drawer"}}

{{/page}}
