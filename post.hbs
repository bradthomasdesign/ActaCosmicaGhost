{{!< default}}
{{#post}}

{{> "site-header" slim=true back_label=primary_tag.name back_href=primary_tag.url}}

<main id="main-content">

<!-- ARTICLE HERO -->
{{!-- Opt-in hero layouts, chosen with an internal tag on the post. One per
      post; if a post carries several, #video wins, then #hero-split-right,
      #hero-split-left, #hero-slideshow. The split and slideshow layouts
      need a feature image and fall back to the default hero without one. --}}
{{#has tag="#video"}}
{{> "post-hero-video"}}
{{else}}{{#has tag="#hero-split-right"}}
{{#if feature_image}}{{> "post-hero-split" side="right"}}{{else}}{{> "post-hero"}}{{/if}}
{{else}}{{#has tag="#hero-split-left"}}
{{#if feature_image}}{{> "post-hero-split" side="left"}}{{else}}{{> "post-hero"}}{{/if}}
{{else}}{{#has tag="#hero-slideshow"}}
{{#if feature_image}}{{> "post-hero-slideshow"}}{{else}}{{> "post-hero"}}{{/if}}
{{else}}
{{> "post-hero"}}
{{/has}}{{/has}}{{/has}}{{/has}}

<!-- BYLINE BAR -->
<div style="border-bottom:1px solid var(--rule);">
  <div style="max-width:820px;margin:0 auto;padding:24px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
    <div style="display:flex;align-items:center;gap:14px;">
      {{#if primary_author.profile_image}}
      <img src="{{img_url primary_author.profile_image size="s"}}" alt="{{primary_author.name}}" style="width:46px;height:46px;border-radius:50%;object-fit:cover;flex:0 0 auto;" />
      {{else}}
      {{#primary_author}}{{> "avatar-initials" size="46" font="17"}}{{/primary_author}}
      {{/if}}
      <div>
        <a href="{{primary_author.url}}" style="font:700 14px/1.2 var(--gh-font-heading,'Archivo');color:var(--ink);text-decoration:none;">By {{primary_author.name}}</a>
        <div style="font:400 14px/1.3 var(--gh-font-heading,'Archivo');color:var(--ink-muted);margin-top:3px;">Published {{date published_at format="MMM D, YYYY"}} · {{reading_time}}</div>
      </div>
    </div>
    <div id="share-bar" style="display:flex;align-items:center;gap:9px;">
      <span class="share-label" style="font:600 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.1em;text-transform:uppercase;color:var(--ink-muted);margin-right:4px;">Share</span>
      <a data-share="x" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on X" style="width:36px;height:36px;border-radius:50%;border:1px solid var(--rule-strong);display:flex;align-items:center;justify-content:center;font:700 14px/1 var(--gh-font-heading,'Archivo');color:var(--ink);text-decoration:none;">X</a>
      <a data-share="facebook" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" style="width:36px;height:36px;border-radius:50%;border:1px solid var(--rule-strong);display:flex;align-items:center;justify-content:center;font:700 14px/1 var(--gh-font-heading,'Archivo');color:var(--ink);text-decoration:none;">f</a>
      <a data-share="linkedin" href="#" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" style="width:36px;height:36px;border-radius:50%;border:1px solid var(--rule-strong);display:flex;align-items:center;justify-content:center;font:700 14px/1 var(--gh-font-heading,'Archivo');color:var(--ink);text-decoration:none;">in</a>
      <button type="button" data-copy-link="{{url absolute="true"}}" aria-label="Copy link" style="width:36px;height:36px;border-radius:50%;border:1px solid var(--rule-strong);background:none;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--ink)" stroke-width="2" stroke-linecap="round"><path d="M9 15l6-6"></path><path d="M11 6l1-1a4 4 0 0 1 6 6l-1 1"></path><path d="M13 18l-1 1a4 4 0 0 1-6-6l1-1"></path></svg>
      </button>
      <!-- Native share button — shown by JS on touch devices with navigator.share -->
      <button type="button" id="native-share-btn" aria-label="Share" style="display:none;align-items:center;gap:7px;height:36px;padding:0 16px;border-radius:100px;border:1px solid var(--rule-strong);background:none;cursor:pointer;font:600 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.06em;text-transform:uppercase;color:var(--ink);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
        Share
      </button>
      <!-- Reader controls: text size + appearance, remembered per reader -->
      <div class="reader-controls" style="position:relative;margin-left:4px;">
        <button type="button" id="reader-controls-btn" aria-label="Reading settings" aria-expanded="false" aria-controls="reader-controls-panel" style="width:36px;height:36px;border-radius:50%;border:1px solid var(--rule-strong);background:none;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;color:var(--ink);font:700 14px/1 var(--gh-font-heading,'Archivo');">Aa</button>
        <div id="reader-controls-panel" class="reader-controls-panel" role="dialog" aria-label="Reading settings" hidden>
          <fieldset>
            <legend>Text size</legend>
            <div class="rc-group"><label class="rc-option"><input type="radio" name="rc-size" value="small" /><span>Small</span></label><label class="rc-option"><input type="radio" name="rc-size" value="default" /><span>Default</span></label><label class="rc-option"><input type="radio" name="rc-size" value="large" /><span>Large</span></label></div>
          </fieldset>
          {{#match @custom.color_scheme "System"}}
          <fieldset>
            <legend>Appearance</legend>
            <div class="rc-group"><label class="rc-option"><input type="radio" name="rc-theme" value="light" /><span>Light</span></label><label class="rc-option"><input type="radio" name="rc-theme" value="dark" /><span>Dark</span></label><label class="rc-option"><input type="radio" name="rc-theme" value="system" /><span>System</span></label></div>
          </fieldset>
          {{/match}}
        </div>
      </div>
      <!-- Bookmark toggle -->
      <button type="button" data-bookmark="{{slug}}" aria-label="Save for later" aria-pressed="false" style="width:36px;height:36px;border-radius:50%;border:1px solid var(--rule-strong);background:none;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;margin-left:4px;">
        <svg class="bookmark-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--ink)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M6 4h12v16l-6-4-6 4z"></path></svg>
      </button>
    </div>
  </div>
</div>

<!-- ARTICLE BODY -->
<article class="{{post_class}} article-body" style="max-width:760px;margin:0 auto;padding:48px 24px 8px;font:400 calc(20px * var(--reading-scale, 1))/1.72 var(--gh-font-body,'Newsreader'),Georgia,serif;color:var(--ink-body);">
  {{#has tag="#toc"}}
  {{!-- "In this story" contents list, built by main.js from the post's own
        H2/H3 section headings. Hides itself when there are fewer than two. --}}
  <nav class="story-toc" aria-labelledby="story-toc-title" data-toc hidden>
    <details class="story-toc__details" open>
      <summary id="story-toc-title">In this story</summary>
      <ol class="story-toc__list"></ol>
    </details>
  </nav>
  {{/has}}
  {{content}}

  <!-- PAYWALL CTA — the content helper above is already truncated by Ghost
       core to the free preview when the visitor lacks access, so this just
       adds the upgrade prompt after it; no client-side gating needed.
       (Do not write a literal double-curly content reference in this
       comment — Handlebars renders it live even inside an HTML comment,
       which silently duplicated every article into the page source.) -->
  {{#unless access}}
  <section class="paywall-cta reveal" style="margin:16px 0 8px;padding:clamp(28px,4vw,44px) clamp(24px,4vw,40px);text-align:center;background:var(--paper-alt);border:1px solid var(--rule-soft);border-radius:4px;">
    <div style="display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--paper-raised);border:1px solid var(--rule);margin-bottom:18px;">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--ink)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><rect x="4" y="11" width="16" height="9" rx="1"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
    </div>
    <h2 style="font:800 clamp(22px,2.4vw,28px)/1.2 var(--gh-font-heading,'Archivo'),sans-serif;letter-spacing:-0.01em;color:var(--ink);margin:0 0 10px;">This story is for subscribers</h2>
    <p style="font:400 17px/1.55 var(--gh-font-body,'Newsreader'),Georgia,serif;color:var(--ink-soft);margin:0 auto 26px;max-width:440px;">Subscribe to {{@site.title}} to keep reading — and to support the reporting behind it.</p>
    <button type="button" data-portal="signup" style="background:var(--ink);color:var(--paper);font:700 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.08em;text-transform:uppercase;padding:15px 32px;border:none;border-radius:2px;cursor:pointer;">Subscribe now</button>
    <p style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:var(--ink-muted);margin:18px 0 0;">Already a member? <a data-portal="signin" href="#/portal/signin" style="color:var(--ink);text-decoration:underline;text-underline-offset:2px;cursor:pointer;">Sign in</a></p>
  </section>
  {{/unless}}

  <div style="display:flex;flex-wrap:wrap;gap:9px;margin:40px 0 8px;">
    {{#foreach tags}}
    <a href="{{url}}" style="font:600 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);border:1px solid var(--rule-strong);padding:8px 13px;border-radius:100px;text-decoration:none;">{{name}}</a>
    {{/foreach}}
  </div>
</article>

{{> "members/article-cta"}}

<!-- AUTHOR CARD -->
<section style="max-width:760px;margin:0 auto;padding:20px 24px 8px;">
  <div style="display:flex;gap:18px;align-items:flex-start;background:var(--paper-alt);border:1px solid var(--rule-soft);padding:24px;border-radius:4px;">
    {{#if primary_author.profile_image}}
    <img src="{{img_url primary_author.profile_image size="s"}}" alt="{{primary_author.name}}" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex:0 0 auto;" />
    {{else}}
    {{#primary_author}}{{> "avatar-initials" size="56" font="21"}}{{/primary_author}}
    {{/if}}
    <div>
      <a href="{{primary_author.url}}" style="font:700 15px/1.2 var(--gh-font-heading,'Archivo');color:var(--ink);text-decoration:none;margin-bottom:6px;display:block;">{{primary_author.name}}</a>
      {{#if primary_author.bio}}<p style="font:400 15px/1.55 var(--gh-font-body,'Newsreader'),Georgia,serif;color:var(--ink-soft);margin:0 0 10px;">{{primary_author.bio}}</p>{{/if}}
      <a class="link-underline" href="{{primary_author.url}}" style="font:600 13px/1 var(--gh-font-heading,'Archivo');letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);text-decoration:none;">More from {{primary_author.name}} →</a>
    </div>
  </div>
</section>

<!-- COMMENTS -->
{{#if comments}}
<section style="max-width:760px;margin:0 auto;padding:40px 24px 8px;color:var(--ink);">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;padding-bottom:14px;border-bottom:2px solid var(--ink);">
    <span style="width:22px;height:22px;background:var(--accent,#f5c518);display:block;"></span>
    <h2 style="font:800 20px/1 var(--gh-font-heading,'Archivo');letter-spacing:.02em;text-transform:uppercase;color:var(--ink);margin:0;">Discussion</h2>
  </div>
  {{comments}}
</section>
{{/if}}

<!-- RELATED -->
{{#if primary_tag}}
{{#get "posts" filter="primary_tag:{{primary_tag.slug}}+id:-{{id}}" limit="3" include="tags" as |related|}}
{{#if related}}
<section style="max-width:1120px;margin:0 auto;padding:56px 24px;">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;padding-bottom:14px;border-bottom:2px solid var(--ink);">
    <span style="width:22px;height:22px;background:var(--accent,#f5c518);display:block;"></span>
    <h2 style="font:800 20px/1 var(--gh-font-heading,'Archivo');letter-spacing:.02em;text-transform:uppercase;color:var(--ink);margin:0;">More in {{../primary_tag.name}}</h2>
  </div>
  <div class="story-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
    {{#foreach related}}
    <a class="card-link" href="{{url}}" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;">
      <div class="article-image-frame" style="position:relative;overflow:hidden;width:100%;aspect-ratio:3/2;margin-bottom:14px;background:#2b3a55;">
        {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;" />{{else}}{{> "text-card-fill"}}{{/if}}{{> "video-badge"}}
      </div>
      <div style="display:flex;align-items:center;gap:7px;margin-bottom:9px;">
        <span style="width:4px;height:14px;background:var(--accent,#f5c518);display:block;"></span>
        <span style="font:700 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.14em;text-transform:uppercase;color:var(--ink);">{{primary_tag.name}}</span>
      </div>
      <h3 style="font:600 20px/1.22 var(--gh-font-heading,'Archivo'),sans-serif;color:var(--ink);margin:0;text-wrap:balance;">{{title}}</h3>
    </a>
    {{/foreach}}
  </div>
</section>
{{/if}}
{{/get}}
{{/if}}

{{> "newsletter"}}
</main>

{{> "site-footer"}}
{{> "nav-drawer"}}

{{/post}}
