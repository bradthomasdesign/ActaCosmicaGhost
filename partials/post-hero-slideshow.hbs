{{!-- Slideshow hero (#hero-slideshow): the feature image is slide one; main.js
      appends the images from the post's first gallery card (removing that
      gallery from the body so photos aren't shown twice). Manual only —
      arrows, dots, ← / → keys or swipe; nothing moves on its own. Captions
      come from each image's alt text. --}}
<section class="hero-slideshow" aria-roledescription="carousel" aria-label="Photo slideshow">
  <div class="hero-slideshow__stage" data-slideshow>
    <div class="hero-slideshow__track">
      <figure class="hero-slideshow__slide is-active" aria-roledescription="slide" aria-label="1">
        <div class="hero-slideshow__blur" style="background-image:url('{{img_url feature_image size="s"}}')"></div>
        <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
        {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
      </figure>
    </div>
    <button type="button" class="hero-slideshow__arrow hero-slideshow__arrow--prev" aria-label="Previous photo" hidden>‹</button>
    <button type="button" class="hero-slideshow__arrow hero-slideshow__arrow--next" aria-label="Next photo" hidden>›</button>
    <div class="hero-slideshow__dots" role="group" aria-label="Choose photo" hidden></div>
    <p class="hero-slideshow__status" aria-live="polite"></p>
  </div>
  <div class="hero-slideshow__text">
    {{#if primary_tag}}<div class="hero-kicker"><span aria-hidden="true"></span><a href="{{primary_tag.url}}">{{primary_tag.name}}</a></div>{{/if}}
    <h1 class="hero-slideshow__title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="hero-slideshow__dek">{{custom_excerpt}}</p>{{/if}}
  </div>
</section>
