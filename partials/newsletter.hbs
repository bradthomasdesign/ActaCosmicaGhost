<section id="newsletter" style="background:var(--band);padding:72px 24px;scroll-margin-top:120px;">
  <div style="max-width:680px;margin:0 auto;text-align:center;">
    {{!-- Copy comes from a page with the slug newsletter-band when one is
          published: Title = headline, Excerpt = the line beneath, Meta
          title = the small label above. A heading/sub passed to this partial
          (the membership page does) wins over both. --}}
    {{#get "pages" filter="slug:newsletter-band" limit="1" as |bandPages|}}
    {{#if bandPages}}
    {{#foreach bandPages}}{{#if ../../heading}}{{> "newsletter-copy" label=meta_title headline=../../heading text=../../sub}}{{else}}{{> "newsletter-copy" label=meta_title headline=title text=custom_excerpt}}{{/if}}{{/foreach}}
    {{else}}
    {{> "newsletter-copy" headline=../heading text=../sub}}
    {{/if}}
    {{/get}}
    <form data-members-form="signup" style="display:flex;gap:10px;max-width:460px;margin:0 auto;flex-wrap:wrap;justify-content:center;">
      <input data-members-email type="email" aria-label="Email address" placeholder="Your email address" required style="flex:1;min-width:220px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);color:#fff;font:400 15px/1 var(--gh-font-heading,'Archivo');padding:14px 16px;border-radius:2px;outline:none;" />
      <button type="submit" style="background:var(--accent,{{@custom.accent_color}});color:var(--accent-text,#16130d);border:none;font:700 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.08em;text-transform:uppercase;padding:14px 26px;border-radius:2px;cursor:pointer;"><span>Sign Up</span></button>
      <div class="message-success" role="status" style="width:100%;font:400 14px/1.5 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.75);margin-top:4px;">Thanks — check your inbox to confirm.</div>
      <div class="message-error" role="alert" style="width:100%;font:400 14px/1.5 var(--gh-font-heading,'Archivo');color:#f5a5a5;margin-top:4px;"></div>
    </form>
  </div>
</section>
