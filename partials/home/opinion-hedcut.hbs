{{#get "posts" filter="tag:{{section_tag}}" limit="6" include="tags,authors" as |rowPosts|}}
{{#if rowPosts}}
<section class="hrow hrow--opinion reveal" data-layout-row="opinion-hedcut">
  {{> "home/row-head" name=../section_name url=../section_url dek=../section_dek}}
  <div class="opinion">
    {{#foreach rowPosts}}
    <a class="opinion__card card-link" href="{{url}}">
      {{#if primary_author.profile_image}}
      <img class="opinion__face" src="{{img_url primary_author.profile_image size="s"}}" alt="" loading="lazy" />
      {{else}}
      <span class="opinion__face opinion__face--blank" aria-hidden="true"></span>
      {{/if}}
      <span class="opinion__text">
        <span class="opinion__title">{{title}}</span>
        <span class="opinion__byline">{{primary_author.name}}</span>
      </span>
    </a>
    {{/foreach}}
  </div>
</section>
{{/if}}
{{/get}}
