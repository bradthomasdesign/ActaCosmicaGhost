{{#get "posts" filter="tag:{{section_tag}}" limit="5" include="tags,authors" as |rowPosts|}}
{{#if rowPosts}}
<section class="hrow hrow--feature-rail reveal" data-layout-row="feature-rail">
  {{> "home/row-head" name=../section_name url=../section_url dek=../section_dek}}
  <div class="fp">
    {{#foreach rowPosts}}
    {{#if @first}}
    <a class="fp__hero card-link{{#unless feature_image}} fp__hero--text{{/unless}}" href="{{url}}">
      {{#if feature_image}}<img src="{{img_url feature_image size="l"}}" alt="{{title}}" loading="lazy" />{{/if}}
      <div class="fp__hero-text">
        {{> "card-kicker"}}
        <h3>{{title}}</h3>
        {{#if feature_image}}{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}{{else}}<p>{{excerpt words="50"}}</p>{{/if}}
        <div class="card-meta">By {{primary_author.name}} · {{reading_time}}</div>
      </div>
    </a>
    {{/if}}
    {{/foreach}}
    <div class="fr__rail">
      {{#foreach rowPosts from="2"}}
      <a class="fr__item card-link" href="{{url}}">
        <div class="fr__text">{{> "card-kicker"}}<h3>{{title}}</h3><div class="card-meta">{{reading_time}}</div></div>
        {{#if feature_image}}<span class="fr__thumb"><img src="{{img_url feature_image size="s"}}" alt="" loading="lazy" />{{> "video-badge"}}</span>{{/if}}
      </a>
      {{/foreach}}
    </div>
  </div>
</section>
{{/if}}
{{/get}}
