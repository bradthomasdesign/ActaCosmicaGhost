{{#get "posts" filter="tag:{{section_tag}}" limit="5" include="tags,authors" as |rowPosts|}}
{{#if rowPosts}}
<section class="hrow hrow--feature-package reveal" data-layout-row="feature-package">
  {{> "home/row-head" name=../section_name url=../section_url dek=../section_dek}}
  <div class="fp">
    {{#foreach rowPosts}}
    {{#if @first}}
    <a class="fp__hero card-link{{#unless feature_image}} fp__hero--text{{/unless}}" href="{{url}}">
      {{#if feature_image}}<img src="{{img_url feature_image size="l"}}" alt="{{title}}" loading="lazy" />{{/if}}
      <div class="fp__hero-text">
        {{> "card-kicker"}}
        <h3>{{title}}</h3>
        {{#if feature_image}}{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}{{else}}<p>{{excerpt words="50"}}</p>{{/if}}
        <div class="card-meta">By {{primary_author.name}} · {{reading_time}}</div>
      </div>
    </a>
    {{/if}}
    {{/foreach}}
    <div class="fp__side">
      {{#foreach rowPosts from="2" limit="1"}}
      <a class="fp__second card-link" href="{{url}}">
        {{> "card-image" ratio="3/2" size="m"}}
        <div>{{> "card-kicker"}}<h3>{{title}}</h3></div>
      </a>
      {{/foreach}}
      <ol class="fp__list">
        {{#foreach rowPosts from="3"}}
        <li><a class="card-link" href="{{url}}">
          <span class="fp__num" aria-hidden="true">{{@number}}</span>
          <span class="fp__list-text">{{> "card-kicker"}}<span class="fp__list-title">{{title}}</span></span>
          {{#if feature_image}}<span class="fp__thumb"><img src="{{img_url feature_image size="xs"}}" alt="" loading="lazy" />{{> "video-badge"}}</span>{{/if}}
        </a></li>
        {{/foreach}}
      </ol>
    </div>
  </div>
</section>
{{/if}}
{{/get}}
