{{!-- One ad slot. Renders the body of the page whose slug is ad_slug — an
      image banner (optionally a desktop image followed by a mobile image) or
      ad-network code. Nothing renders when ads are off, for paying members,
      or when the slot's page doesn't exist. ad_variant styles the slot. --}}
{{#if @custom.enable_ads}}{{#unless @member.paid}}
{{#get "pages" filter="slug:{{ad_slug}}" limit="1"}}
{{#foreach pages}}
<aside class="ad ad--{{../../ad_variant}}" aria-label="Advertisement" data-ad>
  <div class="ad__inner">
    <span class="ad__label">Advertisement</span>
    <div class="ad__body">{{content}}</div>
  </div>
</aside>
{{/foreach}}
{{/get}}
{{/unless}}{{/if}}
