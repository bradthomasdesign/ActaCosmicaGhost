{{#get "pages" filter="slug:{{ad_slug}}" limit="1"}}
{{#foreach pages}}
<aside class="ad ad--{{../../ad_variant}}" aria-label="Advertisement" data-ad>
  <div class="ad__inner">
    <span class="ad__label">Advertisement</span>
    <div class="ad__body">{{content}}</div>
  </div>
</aside>
{{/foreach}}
{{/get}}
