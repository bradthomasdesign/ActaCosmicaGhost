{{!-- One homepage spotlight row. Rendered once per homepage section page
      (see index.hbs): a Ghost page whose first (primary) tag is the public
      section tag, plus the internal tag #home-spotlight. section_tag is
      that primary tag's slug. Silently renders nothing when the tag has no
      non-featured posts. --}}
{{#get "posts" filter="primary_tag:{{section_tag}}+featured:false" limit="4" include="tags"}}
{{#if posts}}
<section class="reveal" style="max-width:1280px;margin:0 auto;padding:40px 24px;">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:26px;padding-bottom:14px;border-bottom:2px solid #16130d;">
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="width:26px;height:26px;background:var(--accent,#f5c518);display:block;"></span>
      <h2 style="font:800 24px/1 var(--gh-font-heading,'Archivo');letter-spacing:.02em;text-transform:uppercase;color:#16130d;margin:0;">{{#foreach posts}}{{#if @first}}{{primary_tag.name}}{{/if}}{{/foreach}}</h2>
    </div>
    {{#foreach posts}}{{#if @first}}<a class="link-underline" href="{{primary_tag.url}}" style="font:600 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.08em;text-transform:uppercase;color:#4a4437;text-decoration:none;">See all →</a>{{/if}}{{/foreach}}
  </div>
  <div class="cards-2-mobile" style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px;">
    {{#foreach posts}}
    <a class="card-link" href="{{url}}" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;">
      <div class="article-image-frame" style="position:relative;overflow:hidden;width:100%;aspect-ratio:4/3;margin-bottom:14px;background:#2b3a55;">
        {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;" />{{/if}}
      </div>
      <div style="display:flex;align-items:center;gap:7px;margin-bottom:9px;">
        <span style="width:4px;height:14px;background:var(--accent,#f5c518);display:block;"></span>
        <span style="font:700 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.14em;text-transform:uppercase;color:#16130d;">{{primary_tag.name}}</span>
      </div>
      <h3 style="font:600 19px/1.22 var(--gh-font-heading,'Archivo'),sans-serif;color:#16130d;margin:0;text-wrap:balance;">{{title}}</h3>
    </a>
    {{/foreach}}
  </div>
</section>
{{/if}}
{{/get}}
