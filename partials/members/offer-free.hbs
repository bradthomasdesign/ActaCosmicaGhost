{{!-- Free signup: Ghost's magic-link form. --}}
<div class="offer offer--free">
  <div class="offer__badge">Free membership</div>
  <div class="offer__price"><span class="offer__amount">Free</span><span class="offer__per">/ forever</span></div>
  <form class="offer__form" data-members-form="signup">
    <input data-members-email type="email" aria-label="Email address" placeholder="Your email address" required />
    <button type="submit" class="offer__button">Join free</button>
    <p class="message-success" role="status">Check your inbox for a link to finish signing up.</p>
    <p class="message-error" role="alert"></p>
  </form>
</div>
