{{!-- Card image frame. A story without a feature image gets a text-card fill
      instead of an empty block. ratio: CSS aspect ratio; size: img_url size. --}}
<div class="article-image-frame card-img" style="aspect-ratio:{{ratio}};">
  {{#if feature_image}}<img src="{{img_url feature_image size=size}}" alt="{{title}}" loading="lazy" />{{else}}{{> "text-card-fill"}}{{/if}}{{> "video-badge"}}
</div>
