<footer style="background:#0d0b07;color:rgba(255,255,255,0.7);padding:56px 24px 40px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="display:flex;flex-wrap:wrap;gap:48px;justify-content:space-between;padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,0.12);">
      <div style="max-width:280px;">
        <div style="display:flex;align-items:baseline;gap:2px;margin-bottom:14px;">
          <span style="font:800 22px/1 var(--gh-font-heading,'Archivo');color:#fff;">{{@site.title}}</span>
          {{#if @custom.show_logo_mark}}<span class="logo-mark" style="width:7px;height:7px;background:var(--accent,{{@custom.accent_color}});display:inline-block;"></span>{{/if}}
        </div>
        <p style="font:400 14px/1.6 var(--gh-font-body,'Newsreader'),Georgia,serif;color:rgba(255,255,255,0.55);margin:0;">{{@custom.footer_description}}</p>
      </div>
      <div style="display:flex;gap:56px;flex-wrap:wrap;">
        {{!-- SECTIONS — the sections featured on the homepage (one link per
              homepage section page, in homepage order), so the footer always
              matches what the front page promotes rather than listing every tag.
              Hidden when the homepage has no section rows. --}}
        {{#get "pages" filter="tag:[hash-home-spotlight,hash-home-feature-package,hash-home-feature-rail,hash-home-briefing,hash-home-briefing-carousel,hash-home-asymmetric-lead-list,hash-home-opinion-hedcut,hash-home-tag-columns,hash-home-standard-3-column-grid,hash-home-standard-4-column-grid]" limit="12" include="tags" order="published_at desc" as |sections|}}
        {{#if sections}}
        <div>
          <div style="font:700 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.14em;text-transform:uppercase;color:#fff;margin-bottom:16px;">Sections</div>
          <div class="footer-sections" style="display:flex;flex-direction:column;gap:11px;">
            {{#foreach sections}}{{#if primary_tag}}<a href="{{primary_tag.url}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">{{primary_tag.name}}</a>
            {{/if}}{{/foreach}}
          </div>
        </div>
        {{/if}}
        {{/get}}
        {{!-- ABOUT — Ghost's Secondary navigation (Settings → Navigation), so the
              site owner picks exactly which pages appear here. --}}
        {{#if @site.secondary_navigation}}
        <div>
          <div style="font:700 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.14em;text-transform:uppercase;color:#fff;margin-bottom:16px;">About</div>
          <div class="footer-nav-links" style="display:flex;flex-direction:column;gap:11px;">
            {{navigation type="secondary"}}
          </div>
        </div>
        {{/if}}
        <div>
          <div style="font:700 14px/1 var(--gh-font-heading,'Archivo');letter-spacing:.14em;text-transform:uppercase;color:#fff;margin-bottom:16px;">Follow</div>
          <div style="display:flex;flex-direction:column;gap:11px;">
            {{#if (social_url type="bluesky")}}<a href="{{social_url type="bluesky"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">Bluesky</a>{{/if}}
            {{#if (social_url type="facebook")}}<a href="{{social_url type="facebook"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">Facebook</a>{{/if}}
            {{#if (social_url type="mastodon")}}<a href="{{social_url type="mastodon"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">Mastodon</a>{{/if}}
            {{#if (social_url type="instagram")}}<a href="{{social_url type="instagram"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">Instagram</a>{{/if}}
            {{#if (social_url type="youtube")}}<a href="{{social_url type="youtube"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">YouTube</a>{{/if}}
            {{#if (social_url type="twitter")}}<a href="{{social_url type="twitter"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">X</a>{{/if}}
            {{#if (social_url type="threads")}}<a href="{{social_url type="threads"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">Threads</a>{{/if}}
            {{#if (social_url type="linkedin")}}<a href="{{social_url type="linkedin"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">LinkedIn</a>{{/if}}
            {{#if (social_url type="tiktok")}}<a href="{{social_url type="tiktok"}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">TikTok</a>{{/if}}
            <a href="/#newsletter" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">Newsletter</a>
            <a href="{{@site.url}}/rss/" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.6);text-decoration:none;">RSS Feed</a>
          </div>
        </div>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding-top:24px;">
      <span style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.55);">
        &copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.
        {{#if @custom.show_footer_credit}}
          {{#if @custom.footer_credit_name}}
            | {{@custom.footer_credit_label}} <a href="{{@custom.footer_credit_url}}" style="color:rgba(255,255,255,0.75);text-decoration:underline;">{{@custom.footer_credit_name}}</a>
          {{/if}}
        {{/if}}
      </span>
      <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center;">
        {{!-- Legal links: every page tagged #footer-legal-link (newest first).
              Until one is tagged, the stock Privacy / Terms / Cookie links show. --}}
        {{#get "pages" filter="tag:hash-footer-legal-link" order="published_at desc" limit="10"}}
        {{#if pages}}
        {{#foreach pages}}<a href="{{url}}" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.55);text-decoration:none;">{{title}}</a>
        {{/foreach}}
        {{else}}
        <a href="/privacy/" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.55);text-decoration:none;">Privacy Policy</a>
        <a href="/terms/" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.55);text-decoration:none;">Terms of Use</a>
        <a href="/cookies/" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.55);text-decoration:none;">Cookie Policy</a>
        {{/if}}
        {{/get}}
        <a href="https://ghost.org/" target="_blank" rel="noopener" style="font:400 14px/1 var(--gh-font-heading,'Archivo');color:rgba(255,255,255,0.55);text-decoration:none;">{{t "Powered by Ghost"}}</a>
      </div>
    </div>
  </div>
</footer>
